# Proprietary and confidential

# Prefer nix-direnv when available — it caches the dev shell and makes
# warm `cd` loads near-instant. Sourcing from a stable path avoids the
# `nix-build '<nixpkgs>' -A nix-direnv` round-trip on every load.
# Falls back to direnv's built-in use_nix if nix-direnv isn't installed
# (still works, just slower) and warns so the gap is visible.
_smk_nix_direnv_loaded=0
for _smk_nix_direnv in \
  "${HOME}/.nix-profile/share/nix-direnv/direnvrc" \
  "/opt/homebrew/share/nix-direnv/direnvrc" \
  "/usr/local/share/nix-direnv/direnvrc" \
  "/run/current-system/sw/share/nix-direnv/direnvrc"; do
  if [[ -f "${_smk_nix_direnv}" ]]; then
    # shellcheck disable=SC1090
    source "${_smk_nix_direnv}"
    _smk_nix_direnv_loaded=1
    break
  fi
done
unset _smk_nix_direnv
# _smk_nix_direnv_loaded intentionally kept in scope — used below when bootstrapping.

get_runmode() {
  lsb_release=$(lsb_release -ds 2>/dev/null)
  lsb_missing=$?

  if [[ -n ${RUN_MODE+x} ]]; then
    echo "$RUN_MODE"
  elif [[ $lsb_missing != 0 ]]; then
    # NixOS - old, global, setup
    echo "global"
  elif [[ ${BUILD_SERVER:-0} == 1 ]] && [[ "$lsb_release" == *"Ubuntu "* ]]; then
    echo "per_env"
  else
    echo "global"
  fi
}

# -*- mode: sh -*-
# Tab completion for repo CLI tools — best-effort only. zsh associates commands
# with completion functions when `compinit` runs (during .zshrc), which is
# before direnv loads this file, so this FPATH entry only helps shells that
# inherited the repo environment at startup (e.g. `exec zsh` inside the repo).
# The reliable path is `smk completions install`, which symlinks
# bin/completions/_* into ~/.zsh/completions — see bin/completions/README.md.
path_add FPATH bin/completions

# Load per-machine secrets (tokens) for smk and repo tooling
export SMK_ENV_SECRETS="$HOME/.config/smk/secrets"
# Watched, so a token added to the file reaches the shell without a manual `direnv reload`.
watch_file "$SMK_ENV_SECRETS"

if [ -f "$SMK_ENV_SECRETS" ]; then
  source "$SMK_ENV_SECRETS"
fi

if [ -f ".tmp/test_conf" ]; then
  source .tmp/test_conf
fi

RUN_MODE=$(get_runmode)
readonly RUN_MODE
# Only to a person: `direnv exec` in a hook, a script or CI captures stderr too, and a stray line there
# reads as the command's own output. `$-` cannot tell, since direnv evaluates in a non-interactive bash
# even from a terminal.
if [[ -t 2 ]]; then
  echo "RUN_MODE = $RUN_MODE"
fi

# Required to be set when using the `dotnet` command in a NixOS dev shell.
# If not set, a first time experience will attempt to run which needs to
# write files to the immutable installation directory.
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=true
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# Set default environment for ASPNETCORE applications to development in
# development shell.
export ASPNETCORE_ENVIRONMENT=development

# This repo, declared. `${WORKSPACE:=$PWD}` deferred to an inherited value, so a shell carrying a
# WORKSPACE from a profile, a CI runner or a parent process handed this repo another repo's root,
# and NIX_CONF_DIR below was built from it. $PWD is exact here: direnv evaluates .envrc with the
# working directory set to the directory holding it, including when loaded from a subdirectory.
export WORKSPACE="$PWD"

# Base Configuration
export NIX_CONF_DIR="$WORKSPACE/.nix"
# NIX_CONF_DIR replaces the dev's *global* nix.conf, so a repo whose
# .nix/nix.conf is missing or predates the flakes line silently disables flakes
# — which breaks `use flake` below, bare `nix flake ...`, and the smk tooling,
# even for a dev who has flakes on globally. Guarantee the features here too.
# extra-experimental-features is additive (appends, never overrides), and
# NIX_CONFIG is honored on top of whatever nix.conf is in effect.
export NIX_CONFIG="extra-experimental-features = nix-command flakes${NIX_CONFIG:+
$NIX_CONFIG}"
if [[ "$RUN_MODE" == "global" ]]; then
  export GITHUB_OWNER="smk"
fi

# Bootstrap Nix dev shell.
if [[ "${_smk_nix_direnv_loaded:-0}" -eq 1 ]]; then
  # nix-direnv rebuilds the shell when a watched file changes, and watches only flake.nix and flake.lock of its
  # own accord; the flake imports these, which a render rewrites.
  watch_file .nix/smk-tools.nix .nix/smk.nix
  # path: prefix forces the Nix path fetcher instead of the git fetcher.
  # Without it, Nix detects the parent git repo and uses git ls-files to
  # determine the source, sweeping all tracked files into the store.
  # With path:, the copy is scoped to .nix/ only (~3 files, near-instant).
  use flake "path:./.nix"
else
  # nix-direnv not available — fall back to nix develop for environment setup.
  # No caching: every load re-evaluates the flake. Install nix-direnv for faster loads:
  #   nix profile install nixpkgs#nix-direnv
  echo >&2 "direnv: nix-direnv not found — falling back to nix develop (no caching)"
  eval "$(nix print-dev-env "path:./.nix")"
fi

# recent versions of nix (2.25.3+) set unusual TMP variables; make sure the directory exists
if [[ -n "${TMP:-}" ]]; then
  mkdir -p "$TMP"
fi
unset _smk_nix_direnv_loaded

# Prepend repo bin/ after Nix shell setup so it wins over any system-installed
# tools with the same name (e.g. ~/bin/smk shadowing bin/smk).
PATH_add bin
PATH_add out

# Wire up zsh completions installed by Nix packages into share/zsh/site-functions.
# SMK_ZSH_COMPLETIONS is exported by the flake's mkShell and captured by nix-direnv
# via nix print-dev-env — shellHook is not used because nix-direnv does not run it.
[[ -n "${SMK_ZSH_COMPLETIONS:-}" ]] && path_add FPATH "$SMK_ZSH_COMPLETIONS"

# Set all Locale to en_US.UTF-8
export LANG="en_US.UTF-8"
export LANGUAGE="en_US.UTF-8"

# AWS Client Configuration
export AWS_DEFAULT_REGION=us-west-2

if [[ "${AWS_ACCESS_KEY_ID+x}" ]] && [[ "${AWS_SECRET_ACCESS_KEY+x}" ]]; then
  echo "*** AWS access keys found. Terraform will use assume role for authorization ***"
  export TF_VAR_use_assume_role="true"
elif [[ ! -s "$HOME/.aws/config" ]] && [[ -s "$WORKSPACE/templates/.aws/config" ]]; then
  mkdir -p "$HOME/.aws"
  echo "Initializing AWS config profiles"
  cp -f "$WORKSPACE/templates/.aws/config" "$HOME/.aws"
fi

# Finalize environment
if [[ ${BUILD_SERVER:-0} == 1 ]]; then
  if [[ "$RUN_MODE" == "global" ]]; then
    export SMK_ENV=GLOBAL
  fi
else
  export SMK_ENV=unset
fi

# THIS FILE IS SMK'S, rewritten on every render. A repository's own environment goes in .envrc.local, beside
# it, which is sourced here when present: variables only this repository needs, and nothing smk sets.
source_env_if_exists .envrc.local
