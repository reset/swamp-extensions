# smk { overwrite: true }
#########################################################################
#
#                 -- Generated with smk --
#      (do not edit unless you know what you're doing)
#
#########################################################################

# http://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,cfg,java,py,kt,rs}]
indent_size = 4

[*.{sln,sln.template}]
indent_style = tab
indent_size = 4

# Godot's style guide and its editors indent GDScript and shaders with tabs, and the shader editor
# reformats to tabs on save. Lua takes tabs too, which is stylua's own default.
[*.{gd,gdshader,lua}]
indent_style = tab
indent_size = 4

[{Makefile,**.mk,go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab
indent_size = 4

[Dockerfile]
indent_size = 4

# Each language's own rules follow, one block per language in smkproj.toml's Languages.
# smk: each language's lines follow
